#!/usr/bin/env bash
# A newer build of the same release (`+101` after `+7`) was never reported:
# SemVer precedence and `versions::Version` both ignore build metadata, so
# `mise outdated` and `mise upgrade` called the installed build current.

PLUGIN_DIR="$MISE_DATA_DIR/plugins/buildmeta"
mkdir -p "$PLUGIN_DIR/bin"

cat <<'LISTALL' >"$PLUGIN_DIR/bin/list-all"
#!/usr/bin/env bash
echo "temurin-25.0.4+7.0.LTS temurin-25.0.4+101.0.LTS"
LISTALL
chmod +x "$PLUGIN_DIR/bin/list-all"

cat <<'INSTALL' >"$PLUGIN_DIR/bin/install"
#!/usr/bin/env bash
mkdir -p "$ASDF_INSTALL_PATH/bin"
printf '#!/usr/bin/env bash\necho "buildmeta %s"\n' "$ASDF_INSTALL_VERSION" \
  >"$ASDF_INSTALL_PATH/bin/buildmeta"
chmod +x "$ASDF_INSTALL_PATH/bin/buildmeta"
INSTALL
chmod +x "$PLUGIN_DIR/bin/install"

cat <<'CONFIG' >mise.toml
[tools]
buildmeta = "temurin-25"
CONFIG
mise install buildmeta@temurin-25.0.4+7.0.LTS

assert "mise outdated buildmeta --json | jq -r '.buildmeta.current'" "temurin-25.0.4+7.0.LTS"
assert "mise outdated buildmeta --json | jq -r '.buildmeta.latest'" "temurin-25.0.4+101.0.LTS"
assert_contains "mise upgrade --dry-run" "Would install buildmeta@temurin-25.0.4+101.0.LTS"

mise upgrade
assert_contains "mise x -- buildmeta" "buildmeta temurin-25.0.4+101.0.LTS"
